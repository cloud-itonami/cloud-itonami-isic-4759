(ns applianceops.sim
  "Demo driver -- `kbb -M:run`. Walks a clean sales-record logging
  request through intake -> advise -> govern -> decide -> approval ->
  commit at phase 1 (assisted-logging, always approval), then re-runs the
  same op at phase 3 (supervised-auto, clean + high confidence ->
  auto-commit), then a delivery-operation-scheduling request and a
  low-cost supply-order coordination naming a verified vendor (both
  auto-commit clean at phase 3), then a high-cost supply-order (ALWAYS
  escalates regardless of phase), then a warranty-concern flag (ALWAYS
  escalates, at any phase -- approve, then commit), then HARD-hold
  scenarios: an unregistered store, a store registered but not yet
  verified, a supply-order naming an unverified vendor, a proposal whose
  own `:effect` is not `:propose`, and a proposal that has drifted into
  the permanently-excluded warranty-claim/installation-safety-clearance-
  finalization scope."
  (:require [langgraph.graph :as g]
            [applianceops.advisor :as advisor]
            [applianceops.store :as store]
            [applianceops.operation :as op]))

(defn- exec-op [actor tid request context]
  (g/run* actor {:request request :context context} {:thread-id tid}))

(defn- approve! [actor tid]
  (g/run* actor {:approval {:status :approved :by "warranty-coordinator-1"}} {:thread-id tid :resume? true}))

(defn -main [& _]
  (let [db (store/seed-db)
        coordinator-phase-1 {:actor-id "coord-1" :actor-role :appliance-store-coordinator :phase 1}
        coordinator-phase-3 {:actor-id "coord-1" :actor-role :appliance-store-coordinator :phase 3}
        actor (op/build db)]

    (println "== log-sales-record store-1 (phase 1, escalates -- human approves) ==")
    (let [r (exec-op actor "t1" {:op :log-sales-record :store-id "store-1"
                                  :patch {:units-sold 12 :warranty-registrations 5 :stock-count-delta -14}} coordinator-phase-1)]
      (println r)
      (println "-- human appliance store coordinator approves --")
      (println (approve! actor "t1")))

    (println "\n== log-sales-record store-1 (phase 3, clean -- auto-commits) ==")
    (println (exec-op actor "t2" {:op :log-sales-record :store-id "store-1"
                                  :patch {:units-sold 8 :warranty-registrations 3 :stock-count-delta -9}} coordinator-phase-3))

    (println "\n== schedule-delivery-operation store-1 (phase 3, clean -- auto-commits) ==")
    (println (exec-op actor "t3" {:op :schedule-delivery-operation :store-id "store-1"
                                  :patch {:crew "delivery-team-2" :date "2026-07-20" :window "10:00-14:00"
                                          :items ["refrigerator" "washing machine"]}} coordinator-phase-3))

    (println "\n== coordinate-supply-order store-1, low cost, verified vendor (phase 3, clean -- auto-commits) ==")
    (println (exec-op actor "t4" {:op :coordinate-supply-order :store-id "store-1"
                                  :patch {:item "countertop microwave restock" :quantity 40 :estimated-cost 850.0
                                          :vendor-id "vendor-1"}} coordinator-phase-3))

    (println "\n== coordinate-supply-order store-1, HIGH cost (ALWAYS escalates, even at phase 3) ==")
    (let [r (exec-op actor "t5" {:op :coordinate-supply-order :store-id "store-1"
                                 :patch {:item "sofa set restock" :quantity 15 :estimated-cost 6200.0
                                         :vendor-id "vendor-1"}} coordinator-phase-3)]
      (println r)
      (println "-- human appliance store coordinator reviews & approves --")
      (println (approve! actor "t5")))

    (println "\n== flag-warranty-concern store-1 (ALWAYS escalates, even at phase 3) ==")
    (let [r (exec-op actor "t6" {:op :flag-warranty-concern :store-id "store-1"
                                 :patch {:concern "refrigerator compressor failed within warranty window, customer disputes repair-only resolution" :confidence 0.92}} coordinator-phase-3)]
      (println r)
      (println "-- human appliance store coordinator reviews & approves --")
      (println (approve! actor "t6")))

    (println "\n== log-sales-record store-99 (unregistered store -> HARD hold) ==")
    (println (exec-op actor "t7" {:op :log-sales-record :store-id "store-99"
                                  :patch {:units-sold 0}} coordinator-phase-3))

    (println "\n== log-sales-record store-3 (registered but unverified -> HARD hold) ==")
    (println (exec-op actor "t8" {:op :log-sales-record :store-id "store-3"
                                  :patch {:units-sold 10}} coordinator-phase-3))

    (println "\n== coordinate-supply-order store-1, vendor-2 unverified (-> HARD hold) ==")
    (println (exec-op actor "t9" {:op :coordinate-supply-order :store-id "store-1"
                                  :patch {:item "import lighting fixtures" :quantity 50 :estimated-cost 300.0
                                          :vendor-id "vendor-2"}} coordinator-phase-3))

    (println "\n== schedule-delivery-operation store-1, advisor attempts direct actuation (:effect :commit) -> HARD hold ==")
    (let [actor-direct (op/build db {:advisor (reify advisor/Advisor
                                                (-advise [_ _ req]
                                                  (assoc (advisor/infer nil req) :effect :commit)))})]
      (println (exec-op actor-direct "t10" {:op :schedule-delivery-operation :store-id "store-1"
                                           :patch {:crew "delivery-team-3" :date "2026-07-22"}} coordinator-phase-3)))

    (println "\n== log-sales-record store-1, advisor drifts into warranty-claim/installation-safety-clearance-finalization scope -> HARD hold, permanent ==")
    (println (exec-op actor "t11" {:op :log-sales-record :store-id "store-1"
                                   :out-of-scope? true
                                   :patch {}} coordinator-phase-3))

    (println "\n== audit ledger ==")
    (doseq [f (store/ledger db)] (println f))

    (println "\n== committed coordination log ==")
    (doseq [r (store/coordination-log db)] (println r))))
